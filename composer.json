{
    "name": "libxa/lib-admin",
    "description": "LibAdmin: a security-first, plugin-extensible admin panel for LibxaFrame.",
    "type": "libxa-module",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "libxa/framework": "^0.11.1"
    },
    "autoload": {
        "psr-4": {
            "Libxa\\Admin\\": "src/",
            "LibxaAdmin\\": "src/"
        }
    },
    "extra": {
        "Libxa": {
            "providers": [
                "Libxa\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LibxaAdminTests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
